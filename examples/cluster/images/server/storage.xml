<!--
  Cold-tier storage policy. The shape never changes; the endpoint and the
  credentials come from the container's environment, which Terraform sets.

  Tables opt in with SETTINGS storage_policy = 'hot_then_cold'. The default
  disk is the local hot volume; parts over the size threshold go straight
  to object storage, and move_factor migrates the oldest hot parts down
  once the volume crosses 90% full.

  support_batch_delete is off because Tigris does not implement the S3
  DeleteObjects batch API; without it, merges that drop source parts log
  a 5xx warning per delete.
-->
<clickhouse>
  <storage_configuration>
    <disks>
      <cold>
        <type>s3</type>
        <endpoint from_env="COLD_ENDPOINT"/>
        <access_key_id from_env="AWS_ACCESS_KEY_ID"/>
        <secret_access_key from_env="AWS_SECRET_ACCESS_KEY"/>
        <region>auto</region>
        <support_batch_delete>false</support_batch_delete>
        <send_metadata>true</send_metadata>
      </cold>
    </disks>
    <policies>
      <hot_then_cold>
        <volumes>
          <hot>
            <disk>default</disk>
            <max_data_part_size_bytes>10737418240</max_data_part_size_bytes>
          </hot>
          <cold>
            <disk>cold</disk>
          </cold>
        </volumes>
        <move_factor>0.1</move_factor>
      </hot_then_cold>
    </policies>
  </storage_configuration>
</clickhouse>
